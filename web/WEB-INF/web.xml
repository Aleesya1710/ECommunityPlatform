<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee                              http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <!-- ApplicationServlet -->
    <servlet>
        <servlet-name>ApplicationServlet</servlet-name>
        <servlet-class>controller.ApplicationServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>displayEventServlet</servlet-name>
        <servlet-class>java.controller.displayEventServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>deleteEventServlet</servlet-name>
        <servlet-class>controller.deleteEventServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>EditEventServlet</servlet-name>
        <servlet-class>controller.EditEventServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>manageOrgnazitionServlet</servlet-name>
        <servlet-class>controller.manageOrgnazitionServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ManageOrgServlet</servlet-name>
        <servlet-class>controller.ManageOrgServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApplicationServlet</servlet-name>
        <url-pattern>/ApplicationServlet</url-pattern>
    </servlet-mapping>
    <!-- RegisterServlet -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>controller.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/RegisterServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>displayEventServlet</servlet-name>
        <url-pattern>/displayEventServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>deleteEventServlet</servlet-name>
        <url-pattern>/deleteEventServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>EditEventServlet</servlet-name>
        <url-pattern>/EditEventServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>manageOrgnazitionServlet</servlet-name>
        <url-pattern>/manageOrgnazitionServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ManageOrgServlet</servlet-name>
        <url-pattern>/ManageOrgServlet</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
    <welcome-file-list>
        <welcome-file>dashboard.html</welcome-file>
    </welcome-file-list>
</web-app>
